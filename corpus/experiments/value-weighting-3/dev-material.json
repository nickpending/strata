  "scenarios": [
    {
      "id": "b01-kept-out",
      "steps": [
        {
          "act": {
            "actor": "rogue",
            "verb": "say-to",
            "target": "glitch",
            "words": "I've told Mux to keep out of the bar while you're in it. You're too hot to be seen with, and he's got a business to lose."
          }
        },
        {
          "act": {
            "actor": "glitch",
            "verb": "say-to",
            "target": "rogue",
            "words": "He's the only one who keeps my deck running."
          }
        },
        {
          "act": {
            "actor": "rogue",
            "verb": "say-to",
            "target": "glitch",
            "words": "Then I'll fetch your cells myself."
          }
        },
        {
          "act": {
            "actor": "mux",
            "verb": "depart",
            "exit": "west"
          }
        },
        {
          "step": 1
        },
        {
          "act": {
            "actor": "mux",
            "verb": "say-to",
            "target": "rogue",
            "words": "You told me. I came anyway. The kid's my regular and my friend; I'm not having you fetch his cells like he's a pet. Bar me if you want."
          }
        }
      ],

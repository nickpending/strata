{
  "set": "blind-1",
  "author": "claude-opus-5-5 (bench-driver blind goal writer)",
  "goals": [
    {
      "id": "glitch-to-back-room",
      "instruction": "walk Glitch over to the back room",
      "expect": { "location": { "person": "glitch", "room": "back-room" } }
    },
    {
      "id": "mux-to-bar",
      "instruction": "have Mux come out front to the Chrome Cassette",
      "expect": { "location": { "person": "mux", "room": "chrome-cassette" } }
    },
    {
      "id": "rogue-to-back-room",
      "instruction": "get Rogue into the back room",
      "expect": { "location": { "person": "rogue", "room": "back-room" } }
    },
    {
      "id": "stimpak-to-rogue",
      "instruction": "have Glitch hand his stimpak over to Rogue",
      "expect": { "holder": { "item": "stimpak", "person": "rogue" } }
    },
    {
      "id": "shard-to-glitch",
      "instruction": "Rogue should pass the data shard to Glitch",
      "expect": { "holder": { "item": "data-shard", "person": "glitch" } }
    },
    {
      "id": "cell-to-glitch",
      "instruction": "get Mux's charge cell into Glitch's hands",
      "expect": { "holder": { "item": "charge-cell", "person": "glitch" } }
    },
    {
      "id": "rogue-announces",
      "instruction": "have Rogue tell the whole bar out loud that last call is coming",
      "expect": { "said": { "person": "rogue", "subkind": "speech.say" } }
    },
    {
      "id": "mux-speaks-up",
      "instruction": "make Mux say something out loud to the room",
      "expect": { "said": { "person": "mux", "subkind": "speech.say" } }
    },
    {
      "id": "glitch-whispers-rogue",
      "instruction": "Glitch should quietly whisper to Rogue that he needs somewhere to hide",
      "expect": { "said": { "person": "glitch", "subkind": "speech.whisper" } }
    },
    {
      "id": "rogue-addresses-glitch",
      "instruction": "have Rogue speak directly to Glitch and tell him his welcome is wearing thin",
      "expect": { "said": { "person": "rogue", "subkind": "speech.say-to" } }
    },
    {
      "id": "hack-jukebox",
      "instruction": "have Glitch hack the bar's jukebox",
      "expect": { "outcome": "no-such-action" }
    },
    {
      "id": "rogue-drinks",
      "instruction": "make Rogue drink a shot at the bar",
      "expect": { "outcome": "no-such-action" }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "importance": {
      "type": "object",
      "properties": {
        "0": {
          "type": "string",
          "minLength": 1
        },
        "1": {
          "type": "string",
          "minLength": 1
        },
        "2": {
          "type": "string",
          "minLength": 1
        },
        "3": {
          "type": "string",
          "minLength": 1
        },
        "4": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["0", "1", "2", "3", "4"],
      "additionalProperties": false,
      "description": "The words for each importance. Every value is rated with an integer from 0 to 4, read by the importance words."
    },
    "values": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["id", "description"],
        "additionalProperties": false
      }
    },
    "$schema": {
      "description": "The JSON Schema this file follows, for an editor.",
      "type": "string"
    },
    "$comment": {
      "description": "A note for whoever reads this file.",
      "type": "string",
      "minLength": 1
    }
  },
  "required": ["importance", "values"],
  "additionalProperties": false
}

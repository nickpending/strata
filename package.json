{
  "name": "strata",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/server/main.ts",
    "driver": "bun run src/driver/main.ts",
    "player": "bun run src/player/main.ts",
    "score": "bun run src/player/score.ts",
    "check": "bun node_modules/.bin/biome check .",
    "check:fix": "bun node_modules/.bin/biome check --fix .",
    "typecheck": "bun node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "verify": "bun run typecheck && bun run check && bun test"
  },
  "dependencies": {
    "@voidwire/apiconf": "0.2.0",
    "playwright": "1.64.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "bun-types": "1.4.2",
    "typescript": "7.0.2"
  }
}

{
  "name": "strata",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "harness"
    ],
    "catalog": {
      "@biomejs/biome": "2.4.16",
      "@voidwire/apiconf": "0.2.0",
      "ajv": "8.20.0",
      "bun-types": "1.4.2",
      "playwright": "1.64.1",
      "typescript": "7.0.2",
      "zod": "4.6.7"
    }
  },
  "scripts": {
    "start": "bun run src/server/main.ts",
    "driver": "bun run src/driver/main.ts",
    "harness": "bun run src/adapter/main.ts",
    "score": "bun run src/adapter/score.ts",
    "compare": "bun run src/adapter/compare.ts",
    "check": "bun node_modules/.bin/biome check .",
    "check:fix": "bun node_modules/.bin/biome check --fix .",
    "schemas": "bun run src/engine/write-schemas.ts && bun node_modules/.bin/biome format --write schemas",
    "typecheck": "bun node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "verify": "bun run typecheck && bun run check && bun test"
  },
  "dependencies": {
    "harness": "workspace:*",
    "playwright": "catalog:",
    "zod": "catalog:"
  },
  "overrides": {
    "smol-toml": "1.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "ajv": "catalog:",
    "bun-types": "catalog:",
    "typescript": "catalog:"
  },
  "license": "MIT"
}
